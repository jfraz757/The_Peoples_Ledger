# Copy this file to .env and fill in your actual keys.
# Never commit .env to GitHub -- it is listed in .gitignore.
# Define each name ONCE: python-dotenv silently keeps only the last copy of a repeated name.

# Get your SerpApi key at https://serpapi.com (100 free searches/month)
SERPAPI_KEY=your_serpapi_key_here

# Get your Anthropic key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Supabase project URL
SUPABASE_URL=https://ursmecdpgtqckacyhnko.supabase.co

# Publishable (public, read-only) key -- the same one index.html ships.
# Used for reads: skip-known, review flags, live-duplicate checks.
SUPABASE_KEY=your_publishable_key_here

# Service-role key -- writes, deletes, and reading submissions. Keep it secret.
# Needed by upload, enrich, maintain, dedupe/purge/clean (--apply), reconcile.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
